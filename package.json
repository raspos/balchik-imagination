{
  "name": "balchik-imagination",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/generate-japanese.mjs && vite --host 127.0.0.1",
    "build": "node scripts/generate-japanese.mjs && tsc --noEmit && vite build",
    "test": "node scripts/generate-japanese.mjs && node --test tests/*.test.mjs",
    "data:collect": "node scripts/collect.mjs && node scripts/collect-indicators.mjs",
    "data:build": "node scripts/derive.mjs",
    "data:links": "node scripts/check-links.mjs",
    "test:ui": "node scripts/generate-japanese.mjs && playwright test",
    "data:comparisons": "node scripts/build-comparisons.mjs",
    "i18n:generate": "node scripts/generate-japanese.mjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "@playwright/test": "^1.64.1"
  }
}
